	column DayOfWeekNo
		formatString: 0
		lineageTag: 329af8be-be4d-4b41-8fd6-7db1d97814d9
		summarizeBy: sum
		isNameInferred
		sourceColumn: [DayOfWeekNo]

		annotation SummarizationSetBy = Automatic

	column ลำดับที่ =
			
			SWITCH (
			    [DayOfWeekNo],
			    1, "Mon",
			    2, "Tue",
			    3, "Wed",
			    4, "Thu",
			    5, "Fri",
			    6, "Sat",
			    7, "Sun",
			    "N/A"
			)
		lineageTag: c34e9051-790f-42c2-9920-c66dd42a6b58
		summarizeBy: none
		sortByColumn: DayOfWeekNo

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "mmmm"),
				    "MonthNo", MONTH([Date]),
				    "DayOfWeek", FORMAT([Date], "dddd"),
				    "DayOfWeekNo", WEEKDAY([Date], 2)
				)

	annotation PBI_Id = eb3d7b66da09410187c8813fb8c6e399


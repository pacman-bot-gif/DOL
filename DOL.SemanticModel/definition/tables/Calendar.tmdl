			defaultHierarchy: LocalDateTable_e5a496d0-9ab9-47d8-bbf2-83a4f7eb1e74.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 5e515a3b-2c55-4cd5-a8b0-c9bd500dfa4d
		summarizeBy: sum
		isNameInferred

	column วันในสัปดาห์ = FORMAT('DOL'[service_date], "dddd", "th-TH")
		lineageTag: b4bc05e7-0b48-4abf-87ba-9a8362da855f
		summarizeBy: none
		sortByColumn: ลำดับวัน

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column ลำดับวัน = WEEKDAY('DOL'[service_date], 2)
		formatString: 0
		lineageTag: 6508c6c4-3b44-4095-b115-b87618dafb18
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column เลขลำดับสัปดาห์ =
			
			VAR CurrentDate = 'DOL'[service_date]
			VAR FirstDayOfMonth = STARTOFMONTH('DOL'[service_date])
			VAR FirstWeekday = WEEKDAY(FirstDayOfMonth, 2) -- ต้องใส่เลข 2 เพื่อตัดสัปดาห์ตามวันจันทร์
			RETURN
			    INT((DAY(CurrentDate) + FirstWeekday - 2) / 7) + 1
		formatString: 0
		lineageTag: bd314d6c-50df-4d9b-aee3-d4500d769ca8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ช่วงเวลา = ```
			
			SWITCH (
			    TRUE(),
			    HOUR ( 'DOL'[task_date,start_datetime] ) < 12, "เช้า", HOUR ( 'DOL'[task_date,start_datetime] ) < 13, "เที่ยง", 
			    HOUR ( 'DOL'[task_date,start_datetime] ) < 18, "บ่าย",                                                                                                                          "กลางคืน"
			)
			```
		lineageTag: 766ff87a-8c26-4643-85a9-6263706393d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

